{
  // Shared by each package's tsconfig.json. The source is TypeScript that Node
  // runs as is (type stripping): only syntax it can erase (no enums,
  // namespaces or parameter properties), and imports name their .ts files. The
  // build turns them into .js in dist/ for npm, with source maps that carry the
  // .ts (dist/ is what's published, not src/).
  "compilerOptions": {
    "target": "es2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "rewriteRelativeImportExtensions": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "sourceMap": true,
    "inlineSources": true,
    "declarationMap": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
