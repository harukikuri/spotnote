{
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter spotnote-examples-react19 run dev",
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "coverage": "c8 node --test \"package/test/*.test.js\" \"mcp/test/*.test.js\"",
    "test:e2e": "pnpm --filter spotnote-e2e run test:e2e",
    "coverage:e2e": "pnpm --filter spotnote-e2e run coverage",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present run typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "c8": "12.0.0",
    "changelogithub": "15.0.5",
    "typescript": "7.0.2"
  }
}
