---
// A text-free placeholder bar (Suspense-skeleton look) so demo recordings
// show layout only, no readable copy.
const { w = "100%", h = 12, dark = false } = Astro.props;
const px = (v) => (typeof v === "number" ? `${v}px` : v);
---

<span class:list={["bar", { "bar-dark": dark }]} style={{ width: px(w), height: px(h) }}></span>
