---
import Bar from "./Bar.astro";
import Card from "./Card.astro";
import ProductCard from "./ProductCard.astro";
import "../../../svelte/styles.css"; // same look as the Svelte example
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Spotnote</title>
  </head>
  <body>
    <header class="nav">
      <div class="nav-inner">
        <span class="brand"><Bar w={96} h={18} dark /></span>
      </div>
    </header>

    <main class="page">
      <section class="hero">
        <h1><Bar w="70%" h={40} dark /></h1>
        <div class="row">
          <span class="btn btn-primary"><Bar w={100} h={14} dark /></span>
          <a class="btn" href="/elsewhere"><Bar w={80} h={14} /></a>
        </div>
      </section>

      <section class="section" id="features">
        <h2><Bar w={120} h={24} dark /></h2>
        <div class="grid">
          {[1, 2, 3].map(() => (
            <Card>
              <h3><Bar w="60%" h={16} dark /></h3>
              <p>
                <Bar />
                <Bar w="75%" />
              </p>
            </Card>
          ))}
        </div>
      </section>

      <section class="section" id="products">
        <h2><Bar w={140} h={24} dark /></h2>
        <div class="grid">
          {[1, 2, 3].map(() => <ProductCard />)}
        </div>
      </section>
    </main>
  </body>
</html>
