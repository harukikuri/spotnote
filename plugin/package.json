{
  "name": "spotnote",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Click a UI element in your Vite dev server, write a note, and copy an AI-agent-ready prompt with the exact source location.",
  "main": "src/index.js",
